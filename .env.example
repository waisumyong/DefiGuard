# Required. Server-side only -- never exposed to the browser.
# Used by app/api/quote/route.ts to call Jupiter's Swap V2 order API.
JUPITER_API_KEY=

# Optional. Server-side only -- never exposed to the browser.
# Solana RPC endpoint used by app/api/fees/route.ts to fetch live
# priority fee data (getRecentPrioritizationFees). If unset, falls
# back to the public https://api.mainnet-beta.solana.com endpoint,
# which is rate-limited. For reliable use, get a free RPC URL from a
# provider like Helius or QuickNode.
SOLANA_RPC_URL=
